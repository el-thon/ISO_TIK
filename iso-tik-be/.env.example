APP_NAME="ISO TIK BE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=iso_tik_be_db
DB_USERNAME=iso_tik_be_user
DB_PASSWORD=iso_tik_be_password

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://host.docker.internal:5173

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@iso-tik.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Seeder
SEED_DEMO_DATA=true
SEED_PRODUCTION_ADMIN=false
SEED_PRODUCTION_PRODUCT_OWNER=false

PRODUCTION_ADMIN_NAME="System Administrator"
PRODUCTION_ADMIN_EMAIL=
PRODUCTION_ADMIN_PASSWORD=

PRODUCTION_PRODUCT_OWNER_NAME="Product Owner"
PRODUCTION_PRODUCT_OWNER_EMAIL=
PRODUCTION_PRODUCT_OWNER_PASSWORD=

DEMO_USER_PASSWORD=

# Audit policy
AUDIT_HASH_CHAIN_ENABLED=false
AUDIT_RETENTION_ENABLED=false
